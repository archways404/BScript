# Required in production: 32 random bytes, hex or base64.  openssl rand -hex 32
BSCRIPT_SECRET_KEY=
BSCRIPT_ADMIN_USER=admin
BSCRIPT_ADMIN_PASSWORD=admin
# Defaults to apps/server/.data; relative paths resolve against the current directory.
# BSCRIPT_DATA_DIR=
BSCRIPT_PUBLIC_URL=http://localhost:3000
MAX_CONCURRENT_RUNS=2
RUN_RETENTION=50
PORT=3000
