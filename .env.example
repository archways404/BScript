# Required in production: 32 random bytes, hex or base64.  openssl rand -hex 32
BSCRIPT_SECRET_KEY=
BSCRIPT_ADMIN_USER=admin
BSCRIPT_ADMIN_PASSWORD=admin
# Defaults to apps/server/.data; relative paths resolve against the current directory.
# BSCRIPT_DATA_DIR=
BSCRIPT_PUBLIC_URL=http://localhost:3000
MAX_CONCURRENT_RUNS=2
RUN_RETENTION=50
# Fork PRs run untrusted code in the BScript container; they get no secrets either way.
BSCRIPT_ALLOW_FORK_PRS=false
# Behind a reverse proxy: true, a hop count, or the proxy's IPs/CIDRs (trusts X-Forwarded-For).
BSCRIPT_TRUST_PROXY=false
# Time zone for cron schedules.
TZ=UTC
PORT=3000
